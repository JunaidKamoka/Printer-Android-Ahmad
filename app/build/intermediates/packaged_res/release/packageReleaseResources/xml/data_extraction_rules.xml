<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ data-extraction (cloud backup + D2D transfer) rules.
     The app stores no user data, so we exclude everything explicitly. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
