<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HPPrinterTools" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/hp_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/hp_dark</item>
    </style>
    <style name="Theme.HPPrinterTools.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/hp_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.HPPrinterTools</item>
    </style>
</resources>