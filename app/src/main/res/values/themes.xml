<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main app theme. Compose owns the look; this just sets the status bar. -->
    <style name="Theme.HPPrinterTools" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/hp_blue</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/hp_blue</item>
    </style>

    <!-- Splash theme used as the launch theme. On Android 12+ uses the SplashScreen API;
         on older versions the SplashScreen compat library renders an equivalent splash. -->
    <style name="Theme.HPPrinterTools.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/hp_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.HPPrinterTools</item>
    </style>
</resources>
