<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      We deliberately keep this manifest minimal:
        • The system photo / document pickers (ActivityResultContracts) hand us
          a content:// URI with read access — no storage permission required.
        • The system camera intent (ACTION_IMAGE_CAPTURE) does not need
          android.permission.CAMERA *unless* we declare it. Declaring it would
          force a runtime prompt and crash if the user denies. So we omit it.
        • Printing happens through the system print framework — we hold no
          network sockets ourselves.
      The only permission we actually need is INTERNET (a normal permission,
      not user-prompted) for the print framework's helper services.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Camera and Wi-Fi are *features*, not required at install time. This
         lets users without a camera install the app while still letting Play
         filter for capable devices. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />

    <!-- Android 11+ package visibility: declare every intent shape we launch
         so the system tells us which apps can handle them and the chooser
         isn't silently empty. -->
    <queries>
        <!-- Photo & document pickers (system-provided, but listing the intent
             shape is still recommended for clarity). -->
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="application/pdf" />
        </intent>

        <!-- Browser handlers. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>

        <!-- PDF / Word viewer for the "Print Document" tool. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/pdf" />
        </intent>

        <!-- Email composer for the "Mobile Fax" tool. -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>

        <!-- System camera capture. -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>

        <!-- Play Store deep-link for "HP Print Plugin" tool. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HPPrinterTools">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.HPPrinterTools.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
