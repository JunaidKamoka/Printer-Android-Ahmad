# Copy this file to keystore.properties (sibling of build.gradle.kts) and fill in
# real values. keystore.properties is gitignored.
#
# Generate a release keystore with:
#   keytool -genkey -v -keystore release.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias hp-printer-release
#
# Then drop release.jks somewhere safe (NOT in source control) and point storeFile at it.

storeFile=../release.jks
storePassword=CHANGE_ME
keyAlias=hp-printer-release
keyPassword=CHANGE_ME
